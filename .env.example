# Copy this file to .env and fill in your values.
# .env is git-ignored — never commit real secrets.

# MongoDB connection string (local or Atlas)
MONGO_URI=mongodb://localhost:27017/achievion

# Port the API server listens on
PORT=3001

# Origins allowed by CORS and Socket.IO (Deploy, D-307): CLIENT_URL = comma-separated list, e.g. https://your-app.vercel.app
# CLIENT_ORIGIN is the older single-origin name, used only when CLIENT_URL is empty. Default http://localhost:5173
CLIENT_URL=
CLIENT_ORIGIN=http://localhost:5173
# Number of proxies in front of the server. Set 1 on Render so rate limits see the real client IP. Leave empty locally.
TRUST_PROXY=
NODE_ENV=

# JWT signing secret — generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-at-least-32-chars-long

# Token lifetime (ms-compatible: 7d, 24h, 1h …)
JWT_EXPIRES_IN=7d

# E-mail: password-reset code (D-073) and offline notifications (D-296). One sender, chosen by MAIL_PROVIDER (D-340).
#   MAIL_PROVIDER=smtp (or empty)  local development only. Render free blocks SMTP ports. Needs all five of SMTP_* and MAIL_FROM.
#       Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=<gmail address>, SMTP_PASS=<16-char App Password>
#   MAIL_PROVIDER=brevo-api        production on Render free: HTTPS to Brevo. Needs BREVO_API_KEY and MAIL_FROM = a sender verified in Brevo.
# If the chosen provider is incomplete, /api/auth/forgot-password returns 503 "Email service is not configured" and offline e-mail stays off.
MAIL_PROVIDER=
BREVO_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM="ACHIEVION <your-address@example.com>"

# File storage (Deploy-prep A, D-300). Render's disk is wiped on every deploy, so project / task attachments, submission files
# and the organisation logo live on Cloudinary (attachments and submissions as type "authenticated" = private; the API hands out
# short-lived signed links after checking login, organisation and membership).
# Missing (development): files stay on the local disk with one warning. Missing (NODE_ENV=production): uploads answer 503.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
